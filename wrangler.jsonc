{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tree-services-pseo",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./out"
  },
  "routes": [
    {
      "pattern": "cantreeservice.com/*",
      "zone_name": "cantreeservice.com"
    },
    {
      "pattern": "www.cantreeservice.com/*",
      "zone_name": "cantreeservice.com"
    },
    {
      "pattern": "*.cantreeservice.com/*",
      "zone_name": "cantreeservice.com"
    }
  ]
}
